# Vorlage fuer .env (Server oder lokal). Kopieren: cp .env.example .env
# Docker Compose liest .env automatisch; .env ist per .gitignore ausgeschlossen.

# --- Sprachmodell -----------------------------------------------------------
MISTRAL_API_KEY=
# Gratis-Tarif: ministral-14b-latest (Standard). Mit Bezahltarif: mistral-medium-latest
MISTRAL_MODELL=

# --- Datenbank (Compose-Postgres; fuer STACKIT die URL ersetzen) -------------
DATABASE_URL=postgres://verwaltung:verwaltung@postgres:5432/verwaltung?sslmode=disable

# --- Whisper-Bruecke (eigener Erkenner fuer Jambonz) -------------------------
# Zufaelliger Wert, z. B.: openssl rand -hex 24
# Derselbe Wert wird in Jambonz als API key des Custom-Vendors "whisper" eingetragen.
WHISPER_BRUECKE_TOKEN=

# --- Jambonz-Adapter ---------------------------------------------------------
JAMBONZ_STT_VENDOR=custom:whisper
JAMBONZ_TTS_VENDOR=elevenlabs
# ElevenLabs Voice-ID je Sprache (Zugangsdaten liegen in Jambonz, nicht hier)
JAMBONZ_STIMME_DE=
JAMBONZ_STIMME_EN=
# Webhook-Signatur (Jambonz-Signature, HMAC-SHA256, Zeitfenster 300 s).
# Ohne Secret werden Jambonz-Webhooks ABGELEHNT - ausser JAMBONZ_OHNE_SIGNATUR=1
# ist gesetzt (nur fuer den allerersten Test gegen eine frische Installation,
# solange die App nur auf 127.0.0.1 erreichbar ist).
JAMBONZ_WEBHOOK_SECRET=
JAMBONZ_OHNE_SIGNATUR=

# --- Netz und Betrieb --------------------------------------------------------
# Adresse, an die Compose die Ports bindet. Standard 127.0.0.1 (nur lokal).
# Auf dem Laptop im WLAN erreichbar machen: BIND_ADDR=0.0.0.0 (nicht auf dem Server!)
BIND_ADDR=
# Mistral-Anfragen je Minute (Gratis-Tarif 30 fuer ministral-14b)
MISTRAL_RPM=25
# Zeitbudget fuer den Modellaufruf je Telefonrunde in ms
TELEFON_RUNDEN_BUDGET_MS=20000
# Whisper: Kerne fuer den Container (Server) und Timeout je Aufruf
WHISPER_CPUS=2.5
WHISPER_TIMEOUT_MS=8000
# Barge-in erst ab so vielen Woertern (Husten unterbricht nicht)
JAMBONZ_MIN_WOERTER=2

# --- Telefon allgemein -------------------------------------------------------
# Erkennungs-Konfidenz, unter der eine Aeusserung als "nicht verstanden" gilt
TELEFON_MIN_KONFIDENZ=0.4
# Stille bzw. Unverstaendliches hintereinander, bevor aufgelegt wird
TELEFON_MAX_STUMM=2
TELEFON_MAX_UNVERSTANDEN=3

# --- Weiterleitung an Menschen (Taste 0 und Werkzeug "weiterleiten") ---------
# Zielnummer im E.164-Format; leer = keine Weiterleitung, stattdessen Hinweis
TELEFON_WEITERLEITUNG_NUMMER=
# Servicezeiten (Europe/Berlin), z. B. "Mo-Fr 08:00-16:00"; leer = immer
TELEFON_WEITERLEITUNG_ZEITEN=
# Satz, wenn keine Weiterleitung moeglich ist (optional)
TELEFON_WEITERLEITUNG_HINWEIS=

# --- Protokoll und Logs ------------------------------------------------------
# Loeschfrist fuer das Gespraechsprotokoll in Tagen (taeglicher Lauf im Server)
PROTOKOLL_TAGE=90
# Aeusserungstexte im Server-Log anzeigen (nur zum Entwickeln; Standard aus)
LOG_TEXT=

# --- Whisper-Bruecke: Pausenerkennung und Parallelitaet ----------------------
# Gleichzeitige Whisper-Aufrufe (Rest wartet); Sprechbeginn/-ende/Vor-/Nachlauf in ms
WHISPER_PARALLEL=2
WHISPER_START_MS=60
WHISPER_ENDE_MS=700
WHISPER_VORLAUF_MS=300
WHISPER_NACHLAUF_MS=200
